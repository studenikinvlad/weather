# Paths are relative to this .env file, not the current working directory.
DATA_DIR=data

# Optional comma-separated Telegram user IDs for the private pilot.
# Empty means anyone can request the two supported cities.
ALLOWED_USER_IDS=''

# Main channel that users must join; the bot must be its administrator.
MAIN_CHANNEL_ID=-1000000000000
MAIN_CHANNEL_URL=https://t.me/your_main_channel
# Application-managed expiry; server-side TTL is unavailable for folders.
FOLDER_INVITE_TTL_SECONDS=300

# Temporarily disabled for this project. Set true to restore the gate.
SUBSCRIPTION_CHECK_ENABLED=false
